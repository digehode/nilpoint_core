{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef inventory_panel %}
    <h3 class="nilpoint-panel-label">Inventory</h3>
    {% with items=player_character.inventory_items.all %}
        {% if items %}
            <ul id="nilpoint-inventory-list">
                {% for inventory_item in items %}
                    {% include "nilpoint/item_card.jinja2#item_card" with card_item=inventory_item %}
                {% endfor %}
            </ul>
        {% else %}
            <p class="nilpoint-empty-state">You are carrying nothing of note at the moment.</p>
        {% endif %}
    {% endwith %}
{% endpartialdef %}
