{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef inventory_panel %}
    <h1>Inventory</h1>
    <ul id="nilpoint-inventory-list">
        {% for inventory_item in player_character.inventory_items.all %}
            <li>
                {% include "nilpoint/item_detail_panel.jinja2#item_icon" %}
                {{ inventory_item.item.name }}
                {% nilpoint_action "Detail" "item_detail" inventory_item=inventory_item.id target="#nilpoint-item-detail-panel" %}
                {% if inventory_item.item.can_drop %}
                    {# here we request the drop but rely on the trigger to update the panel, not the content of the request return.   #}
                    {% nilpoint_action "Drop" "drop_item" method="POST" inventory_item=inventory_item.id swap="none" %}
                {% endif %}
            </li>
        {% empty %}
            <li>None</li>
        {% endfor %}
    </ul>
{% endpartialdef %}
