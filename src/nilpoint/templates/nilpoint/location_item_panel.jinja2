{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef location_item_panel %}
    {% if player_character.current_location %}
        <h3 class="nilpoint-panel-label">Items</h3>
        {% with items=player_character.items_at.all %}
            {% if items %}
                <ul id="nilpoint-item-list">
                    {% for location_item in items %}
                        {% include "nilpoint/item_card.jinja2#item_card" with card_item=location_item %}
                    {% endfor %}
                </ul>
            {% else %}
                <p class="nilpoint-empty-state">There are no items you can investigate here</p>
            {% endif %}
        {% endwith %}
    {% else %}
        <p>No player/location</p>
    {% endif %}
{% endpartialdef %}
