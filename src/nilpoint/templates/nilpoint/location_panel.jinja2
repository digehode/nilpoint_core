{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef location_graphic %}
    {% if location_graphic_override %}
        <img src="{% static location_graphic_override %}"
             height="900"
             width="1600"
             alt="">
    {% else %}
        <img src="{% static player_character.current_location|graphic_for:player_character %}"
             height="900"
             width="1600"
             alt="">
        {% if player_character.current_location %}
            <h3 class="nilpoint-scene-caption">{{ player_character.current_location.name }}</h3>
        {% endif %}
    {% endif %}
{% endpartialdef %}
