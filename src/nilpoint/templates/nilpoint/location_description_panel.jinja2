{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef location_description %}
    {# The location name is the scene caption now; this panel is just the prose. #}
    {% if player_character.current_location %}
        <p>{{ player_character.current_location|description_for:player_character }}</p>
    {% else %}
        <p>No player/location</p>
    {% endif %}
{% endpartialdef %}
