{# The game log: a live region plus the listener for the "nilpoint_log" HX-Trigger event. #}
{# Included by the default landing; a game's own landing reuses it with {% include "nilpoint/log.jinja2" %}. #}
<div id="nilpoint-log"
     class="nilpoint-panel"
     role="log"
     aria-live="polite"
     aria-label="Game log"></div>
<script>
  if (!window.__nilpointLog) {
    window.__nilpointLog = true;          // landing partial re-renders; avoid duplicate listeners
    htmx.on("nilpoint_log", function (event) {
      var messages = event.detail.messages;
      if (!Array.isArray(messages)) {
        return;                           // unexpected shape; nothing to display
      }
      var logEl = document.getElementById("nilpoint-log");
      // Pin-to-bottom: follow new entries only when the reader is already
      // near the end, so scrolling up to read history isn't interrupted.
      // Checked once before appending, so a batch moves it a single time.
      var pinned = logEl.scrollHeight - logEl.scrollTop - logEl.clientHeight < 48;
      messages.forEach(function (item) {
        var entry = document.createElement("div");
        entry.textContent = item.message || "";
        entry.classList.add("nilpoint-log-entry");
        if (item.level) {
          entry.classList.add(item.level);
        }
        logEl.appendChild(entry);
      });
      if (pinned) {
        logEl.scrollTop = logEl.scrollHeight;
      }
    });
  }
</script>
