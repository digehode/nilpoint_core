{% load static i18n %}
{% load nilpoint_tags %}
{% partialdef item_icon_x %}
    <span class="nilpoint-inventory-slot">
        <img class="nilpoint-item-thumb"
             src="{% static current_item.graphic_safe %}"
             width="64"
             height="64"
             alt="{{ current_item.name }}">
    </span>
{% endpartialdef %}
{% partialdef item_icon %}
    {% if item %}
        {% with curremt_item=item %}
            {% partial item_icon_x %}
        {% endwith %}
    {% elif inventory_item.item %}
        {% with current_item=inventory_item.item %}
            {% partial item_icon_x %}
        {% endwith %}
    {% elif location_item.item %}
        {% with current_item=location_item.item %}
            {% partial item_icon_x %}
        {% endwith %}
    {% elif instance.item %}
        {% with current_item=instance.item %}
            {% partial item_icon_x %}
        {% endwith %}
    {% endif %}
{% endpartialdef %}
{% partialdef item_detail %}
    <div id="nilpoint-item-detail">
        <div class="nilpoint-item-detail-graphic">
            {% if item.graphic_safe %}
                <img src="{% static item.graphic_safe %}"
                     alt="{{ item.name }}"
                     width="640"
                     height="640">
            {% endif %}
        </div>
        <div class="nilpoint-item-detail-text">
            <h1>{{ item.name }}</h1>
            <p>{{ item.description }}</p>
            {# Available interaction actions #}
            {% if instance %}
                <div class="nilpoint-item-actions">
                    {% nilpoint_interact_actions instance instance_type target="#nilpoint-interaction-panel" %}
                </div>
            {% endif %}
            {% if debug %}
                <h3>DEBUG</h3>
                {% if state %}
                    <p>has state: {{ state }}</p>
                    <p>{{ state.keys }}</p>
                {% elif instance %}
                    <p>state: {{ instance.item_state_data }}</p>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endpartialdef %}
