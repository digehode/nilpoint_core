{% load static i18n %}
{% partialdef test %}
    <div class="test-interact-show">
        <span data-test="show-partial">SHOW PARTIAL RENDERED</span>
        {# The stable context keys an interaction panel can rely on. #}
        <span data-test="instance">{{ instance.id }}</span>
        <span data-test="item">{{ item.name }}</span>
        <span data-test="pc">{{ pc.handle }}</span>
        <span data-test="interaction">{{ interaction.label }}</span>
    </div>
{% endpartialdef %}
